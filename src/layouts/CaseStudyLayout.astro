---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  client: string;
  summary: string;
  date: string;
  techStack: string[];
}

const { title, client, summary, date, techStack } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-IE', {
  year: 'numeric',
  month: 'long',
});
---

<BaseLayout title={title} description={summary}>
  <article class="max-w-3xl mx-auto px-6 py-20">
    <!-- Back link -->
    <a
      href="/case-studies"
      class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-slate-900 transition-colors mb-12"
    >
      ← All case studies
    </a>

    <!-- Header -->
    <header class="mb-12 pb-12 border-b border-slate-200">
      <p class="text-sm font-medium text-accent uppercase tracking-widest mb-3">
        {client}
      </p>
      <h1 class="text-4xl font-bold text-slate-900 leading-tight mb-4">
        {title}
      </h1>
      <p class="text-xl text-slate-600 leading-relaxed mb-6">{summary}</p>

      <div class="flex flex-wrap items-center gap-4">
        <span class="text-sm text-slate-400">{formattedDate}</span>
        <div class="flex flex-wrap gap-2">
          {
            techStack.map((tech) => (
              <span class="px-3 py-1 bg-slate-100 text-slate-600 text-xs font-medium rounded-full">
                {tech}
              </span>
            ))
          }
        </div>
      </div>
    </header>

    <!-- Content -->
    <div class="prose prose-slate prose-lg max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
