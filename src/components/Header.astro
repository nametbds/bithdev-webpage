---
const nav = [
  { label: 'Work', href: '/case-studies' },
  { label: 'Services', href: '/#services' },
  { label: 'Contact', href: 'mailto:hello@bithdev.ie' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-sm border-b border-slate-200">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="font-bold text-slate-900 text-lg tracking-tight hover:text-accent transition-colors">
      BithDev
    </a>

    <nav class="flex items-center gap-8">
      {nav.map(({ label, href }) => (
        <a
          href={href}
          class:list={[
            'text-sm font-medium transition-colors',
            currentPath === href
              ? 'text-slate-900'
              : 'text-slate-500 hover:text-slate-900',
          ]}
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>
